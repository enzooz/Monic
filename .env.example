# Monic Indumentaria — Variables de entorno
# Copiar como .env y completar los valores

# Credenciales del panel admin
MONIC_ADMIN_USER=admin
MONIC_ADMIN_PASS=cambiar_esta_contraseña

# Clave secreta de Flask (generar una aleatoria y fija)
# Ejemplo Python: python -c "import secrets; print(secrets.token_hex(32))"
MONIC_SECRET_KEY=

# Modo debug (1 = activado, 0 = desactivado)
MONIC_DEBUG=0
